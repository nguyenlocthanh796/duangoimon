# ── POSA Environment Example ────────────────────────────────────────────
# Copy to .env and fill values.
# =========================================================================

# Backend (Local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pos_db
SECRET_KEY=change-this-to-a-random-64-char-string
HARDCODED_USER=admin
HARDCODED_PASS=admin123
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Rate limiting
RATE_LIMIT_LOGIN=50
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_API=600
RATE_LIMIT_WINDOW=60

# Optional
SENTRY_DSN=
REDIS_URL=
MOMO_PARTNER_CODE=
MOMO_SECRET_KEY=
GRAB_API_KEY=
VIETTEL_INVOICE_USER=
VIETTEL_INVOICE_PASS=
