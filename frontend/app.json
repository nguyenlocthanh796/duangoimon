{
  "expo": {
    "name": "POS Pro",
    "slug": "pos-pro",
    "owner": "nguyenlocthanh",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pos-pro",
    "splash": {
      "backgroundColor": "#F97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.armadillo9591.grizzly1520",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F97316"
      },
      "package": "com.posa.pospro"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "jsEngine": "jsc"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d05814b7-24b5-4b85-99a7-df7017563b4b"
      }
    }
  }
}
