{
  "expo": {
    "name": "OngChu POS",
    "slug": "ongchu-pos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "ongchu",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.armadillo9591.grizzly1520",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Ứng dụng cần sử dụng camera để quét mã vạch sản phẩm và mã QR thanh toán VietQR.",
        "NSLocalNetworkUsageDescription": "Ứng dụng cần quyền truy cập mạng cục bộ để tìm kiếm và kết nối máy in hóa đơn nhiệt ESC/POS và két đựng tiền qua mạng Wi-Fi/LAN nội bộ.",
        "NSBonjourServices": [
          "_printer._tcp",
          "_pdl-datastream._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1C1917"
      },
      "package": "vn.ongchu.pos",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "370f05d6-83c8-4abf-965e-2480e9752d84"
      }
    },
    "owner": "locthanhnguyen797"
  }
}
